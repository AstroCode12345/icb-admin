# Copy this file to .env.local and fill in the values.
# Never commit .env.local to GitHub.

# Shared front-door password. Everyone enters this first; it opens the chooser
# and nothing else. Editing anything needs the section password below as well.
ADMIN_PASSWORD=changeme

# GitHub Personal Access Token with "repo" scope
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The GitHub repo containing the website files
GITHUB_REPO=AstroCode12345/icb-website-redesign

# Section passwords, asked for after the shared one. Each opens only its own
# portal and can only publish that portal's part of content.json. ADMIN_PASSWORD
# will not open a section that has its own password set. Leave one blank and
# that section falls back to the shared password, so a half-set-up install is
# still reachable.
MAIN_PASSWORD=
SCHOOL_PASSWORD=
YOUTH_PASSWORD=

# Signs the session tokens. Falls back to ADMIN_PASSWORD if unset. Set it to
# any long random string so changing a portal password does not sign everyone out.
TOKEN_SECRET=
