# Copy this file to .env.local and fill in the values.
# Never commit .env.local to GitHub.

# Fallback password, used only for portals with no password of their own below.
ADMIN_PASSWORD=changeme

# GitHub Personal Access Token with "repo" scope
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The GitHub repo containing the website files
GITHUB_REPO=AstroCode12345/icb-website-redesign

# Per-portal passwords. Each opens only its own portal, and can only publish
# that portal's part of content.json. There is no master password: knowing
# ADMIN_PASSWORD does not open a portal that has its own password set. It is
# only a fallback for a portal you have left blank here, so the app still works
# before all three are configured.
MAIN_PASSWORD=
SCHOOL_PASSWORD=
YOUTH_PASSWORD=

# Signs the session tokens. Falls back to ADMIN_PASSWORD if unset. Set it to
# any long random string so changing a portal password does not sign everyone out.
TOKEN_SECRET=
