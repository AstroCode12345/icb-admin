# Copy this file to .env.local and fill in the values.
# Never commit .env.local to GitHub.

# Password that staff use to log in to this admin panel
ADMIN_PASSWORD=changeme

# GitHub Personal Access Token with "repo" scope
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The GitHub repo containing the website files
GITHUB_REPO=AstroCode12345/icb-website-redesign

# Per-portal passwords. Each opens only its own portal, and can only publish
# that portal's part of content.json. ADMIN_PASSWORD above is the master and
# opens all three. Leave one unset to disable that portal's separate login.
MAIN_PASSWORD=
SCHOOL_PASSWORD=
YOUTH_PASSWORD=

# Signs the session tokens. Falls back to ADMIN_PASSWORD if unset. Set it to
# any long random string so changing a portal password does not sign everyone out.
TOKEN_SECRET=
